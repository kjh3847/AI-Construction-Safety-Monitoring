FROM python:3.12-slim
WORKDIR /app
COPY backend/requirements-accounts.txt .
RUN pip install --no-cache-dir -r requirements-accounts.txt
COPY backend/identity.py backend/identity_db.py backend/account_server.py backend/bootstrap_system.py ./
RUN useradd --create-home app
USER app
EXPOSE 8000
CMD ["uvicorn", "account_server:app", "--host", "0.0.0.0", "--port", "8000"]
