FROM python:3.12-slim
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
COPY backend/requirements-accounts.txt backend/requirements-runtime.txt ./
RUN pip install --no-cache-dir torch==2.15.0 torchvision==0.29.2 --index-url ${TORCH_INDEX_URL} \
    && pip install --no-cache-dir -r requirements-runtime.txt
COPY backend/ ./
COPY global-bundle.pem /app/certs/global-bundle.pem
RUN useradd --uid 10001 --create-home app && mkdir -p /data/recordings /models && chown -R app:app /data
ENV MONITOR_STORAGE_DIR=/data/recordings SAFETY_DB_PATH=/data/safety.db MODEL_PATH=/models/best.pt \
    YOLO_CONFIG_DIR=/data/ultralytics PYTHONUNBUFFERED=1
USER app
EXPOSE 8002
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8002", "--workers", "1", "--no-access-log"]
