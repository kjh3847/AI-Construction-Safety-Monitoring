# Copy to .env; choose a password without URL-reserved characters or URL-encode it.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://safety:replace-with-a-long-random-password@postgres:5432/safety
PUBLIC_APP_URL=http://localhost:5173
COOKIE_SECURE=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# For production: PUBLIC_APP_URL=https://your-domain, COOKIE_SECURE=true,
# DATABASE_URL=postgresql://USER:ENCODED_PASSWORD@RDS_ENDPOINT:5432/safety?sslmode=verify-full&sslrootcert=/app/certs/global-bundle.pem
