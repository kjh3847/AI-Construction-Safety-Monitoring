# Copy to .env; choose a password without URL-reserved characters or URL-encode it.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://safety:replace-with-a-long-random-password@postgres:5432/safety
PUBLIC_APP_URL=http://localhost:5173
COOKIE_SECURE=false
# Keep false for normal account authentication. Use Start-Local.ps1 for isolated loopback demo.
LOCAL_DEMO_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Actual stream endpoints only. Never commit camera addresses or credentials.
# Accepts USB index, local file, HTTP(S) MJPEG or RTSP(S).
CAMERA_01_SOURCE=
CAMERA_02_SOURCE=
CAMERA_03_SOURCE=
CAMERA_01_NAME=CAM-01
CAMERA_02_NAME=CAM-02
CAMERA_03_NAME=CAM-03
CAMERA_RECONNECT_ENABLED=true
CAMERA_RECONNECT_INTERVAL=5
MONITOR_STORAGE_DIR=
SAFETY_DB_PATH=
MODEL_PATH=
MONITOR_AUTOSTART=false
ANALYSIS_FPS=5
RECORDING_FPS=2
CAPTURE_MAX_WIDTH=1280
INFERENCE_SIZE=640
INFERENCE_DEVICE=cpu
# 0 means time retention only. Production: size for the available disk.
RECORDING_MAX_BYTES_PER_CAMERA=0
# Optional trained OSNet ONNX path; inside Docker use /models/osnet_x0_25.onnx.
REID_MODEL_PATH=
REID_THRESHOLD=0.88
REID_THREADS=1
# Directional edges and measured min/max travel seconds; empty disables cross-camera matching.
REID_TRANSITIONS={}

# Merge compose.media.yaml to accept independent RTMPS push streams.
MEDIA_ENABLED=false
STREAM_PUBLIC_HOST=
MEDIA_RTSP_URL=rtsp://mediamtx:8554
MEDIA_API_URL=http://mediamtx:9997
MEDIA_WEBRTC_URL=http://mediamtx:8889
# Per-camera 'direct' retains the existing CAMERA_nn_SOURCE adapter.
CAMERA_01_INPUT=push
CAMERA_02_INPUT=push
CAMERA_03_INPUT=push
# False until real cross-camera capture-clock bounds have been validated.
# Push cross-camera matching requires verified sender timestamps in the adapter;
# no environment flag can convert server receive time into capture time.
# Actual credentials are generated in ignored .env.media, never in this example.
# For production: PUBLIC_APP_URL=https://your-domain, COOKIE_SECURE=true,
# DATABASE_URL=postgresql://USER:ENCODED_PASSWORD@RDS_ENDPOINT:5432/safety?sslmode=verify-full&sslrootcert=/app/certs/global-bundle.pem
